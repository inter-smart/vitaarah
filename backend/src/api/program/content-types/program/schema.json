      "component": "sections.introduction-section",
      "repeatable": false
    },
    "benefits_section": {
      "type": "component",
      "component": "sections.benefits-section",
      "repeatable": false
    },
    "Included_treatments_section": {
      "type": "component",
      "component": "sections.included-treatments-section",
      "repeatable": false
    },
    "who_is_this_for_section": {
      "type": "component",
      "component": "sections.who-is-this-for-section",
      "repeatable": false
    },
    "duration_info_section": {
      "type": "component",
      "component": "sections.treatments-included-section",
      "repeatable": false
    },
    "faq_section": {
      "type": "component",
      "component": "sections.faq-section",
      "repeatable": false
    }
  }
