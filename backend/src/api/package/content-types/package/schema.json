{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "Package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "days": {
      "type": "integer"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "features": {
      "type": "component",
      "component": "common.feature",
      "repeatable": true
    },
    "badgeType": {
      "type": "enumeration",
      "enum": [
        "Best Seller",
        "New Arrival",
        "Featured",
        "Offer Deal"
      ]
    }
  }
}
