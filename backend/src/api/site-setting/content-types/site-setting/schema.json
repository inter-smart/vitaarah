{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "page_title": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "social_share_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "site_url": {
      "type": "string"
    },
    "support_email": {
      "type": "email"
    },
    "support_phone": {
      "type": "string"
    },
    "google_analytics": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "component": "common.seo",
      "repeatable": false
    },
    "support_whatsapp_number": {
      "type": "string"
    },
    "google_analytics_id": {
      "type": "string"
    },
    "google_tag_manager_id": {
      "type": "string"
    },
    "facebook_pixel_id": {
      "type": "string"
    },
    "social_links": {
      "type": "component",
      "component": "navigation.button",
      "repeatable": true
    }
  }
}
