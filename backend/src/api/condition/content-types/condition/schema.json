{
  "kind": "collectionType",
  "collectionName": "conditions",
  "info": {
    "singularName": "condition",
    "pluralName": "conditions",
    "displayName": "Condition"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "symptoms_section": {
      "type": "component",
      "component": "sections.symptoms-section",
      "repeatable": false
    },
    "root_cause_section": {
      "type": "component",
      "component": "sections.root-cause-section",
      "repeatable": false
    },
    "recommended_treatments_section": {
      "type": "component",
      "component": "sections.recommended-treatments-section",
      "repeatable": false
    },
    "lifestyle_section": {
      "type": "component",
      "component": "sections.lifestyle-section",
      "repeatable": false
    },
    "related_treatments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::treatment.treatment",
      "inversedBy": "related_conditions"
    },
    "related_root_causes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::root-cause.root-cause",
      "inversedBy": "related_conditions"
    }
  }
}
