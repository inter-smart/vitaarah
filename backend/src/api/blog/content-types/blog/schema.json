{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "authorName": {
      "type": "string",
      "required": true
    },
    "publishedDate": {
      "type": "date"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "events",
        "treatment"
      ]
    }
  }
}
