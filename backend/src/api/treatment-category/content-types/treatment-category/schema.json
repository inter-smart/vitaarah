{
  "kind": "collectionType",
  "collectionName": "treatment_categories",
  "info": {
    "singularName": "treatment-category",
    "pluralName": "treatment-categories",
    "displayName": "Treatment Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "featured_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "short_description": {
      "type": "text"
    },
    "treatments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::treatment.treatment"
    }
  }
}
