{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "author_name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "author_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "author_designation": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "required": true,
      "default": 4,
      "min": 1,
      "max": 5
    },
    "video_testimonial": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "review": {
      "type": "blocks",
      "required": true
    }
  }
}
